pipeline {
    // Use a Docker agent with Maven 3.9 and JDK 21
    agent {
        docker {
            image 'maven:3.9.6-eclipse-temurin-21'
        }
    }

    environment {
        IMAGE_NAME = "saathi-backend"
        DOCKER_HUB_REPO = "satvik0100/saathi-backend"
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    // No longer need the 'tools' section for Maven, as it's in the Docker image
    triggers {
        cron('H * * * *')
    }

    stages {
        stage('Build Maven') {
            steps {
                // The directory is now relative to the workspace inside the container
                dir('Saathi-Backend') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }
    }

    post {
        success {
            echo "✅ CI pipeline complete for Saathi build #${BUILD_NUMBER}"
        }
        failure {
            echo "❌ Build failed for Saathi build #${BUILD_NUMBER}"
        }
    }
}