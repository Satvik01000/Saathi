pipeline {
    agent any

    environment {
        IMAGE_NAME = "saathi-backend"
        DOCKER_HUB_REPO = "satvik0100/saathi-backend"
        IMAGE_TAG = "${env.BUILD_NUMBER}"
    }
    tools{
        maven 'jenkins-maven'
    }
    triggers {
        cron('H * * * *')
    }

    stages {
        stage('Buld Maven '){
            steps{
                sh 'mvn clean -DskipTests package'
            }
        }
    }

    post {
        always {
            echo "✅ CI pipeline complete for Saathi build #${env.BUILD_NUMBER}"
        }
    }
}
