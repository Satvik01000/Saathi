pipeline {
    agent any

    environment {
        IMAGE_NAME = "saathi-backend"
        DOCKER_HUB_REPO = "satvik0100/saathi-backend"
        IMAGE_TAG = "${env.BUILD_NUMBER}"
    }

    triggers {
        cron('H * * * *')
    }

    stages {
        stage('Docker Build') {
            steps {
                dir('Saathi-Backend') {
                    echo "🔨 Building Docker image: ${DOCKER_HUB_REPO}:${IMAGE_TAG}"
                    sh "docker build -t ${DOCKER_HUB_REPO}:${IMAGE_TAG} ."
                }
            }
        }


    }

    post {
        always {
            echo "✅ CI pipeline complete for Saathi build #${env.BUILD_NUMBER}"
        }
    }
}
